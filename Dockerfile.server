# ══════════════════════════════════════════════════════════════════════════
# MindBridge — Central FL Server (app.py)
# Multi-stage build: keep final image lean, cache the heavy torch/transformers
# layer separately from app code so code changes don't invalidate it.
# ══════════════════════════════════════════════════════════════════════════
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    HF_HOME=/app/.cache/huggingface

WORKDIR /app

# System deps: build tools for torch wheels, libgl for matplotlib headless
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libgl1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# ── Dependency layer (cached unless requirements-docker.txt changes) ────────
COPY requirements-docker.txt .
RUN pip install --no-cache-dir -r requirements-docker.txt \
    && python -c "from transformers import DistilBertTokenizer, DistilBertModel; \
    DistilBertTokenizer.from_pretrained('distilbert-base-uncased'); \
    DistilBertModel.from_pretrained('distilbert-base-uncased')"

# ── App code ──────────────────────────────────────────────────────────────
COPY app.py .
COPY chatbot/ ./chatbot/
COPY templates/ ./templates/
COPY saved_model/ ./saved_model/

# Persistent-data directories — mount these as volumes in production
RUN mkdir -p user_histories user_profiles user_uploads saved_model

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/status || exit 1

# gunicorn instead of Flask's dev server for production
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", \
     "--threads", "4", "--timeout", "120", "app:app"]
